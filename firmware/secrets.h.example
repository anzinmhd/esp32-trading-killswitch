// secrets.h.example
// ─────────────────────────────────────────────────────────────
// Copy this file to secrets.h and fill in your real values.
// secrets.h is in .gitignore — NEVER commit your real tokens.
// ─────────────────────────────────────────────────────────────

#ifndef SECRETS_H
#define SECRETS_H

// ── WiFi ──────────────────────────────────────────────────────
#define WIFI_SSID         "your_wifi_network_name"
#define WIFI_PASSWORD     "your_wifi_password"

// ── Upstox API ───────────────────────────────────────────────
// Generate at: https://upstox.com → My Account → API
// Access tokens expire daily — refresh manually for now
#define UPSTOX_ACCESS_TOKEN   "your_upstox_access_token_here"

// ── Telegram Bot ─────────────────────────────────────────────
// 1. Create bot via @BotFather on Telegram
// 2. Get chat ID from: https://api.telegram.org/bot<TOKEN>/getUpdates
#define TELEGRAM_BOT_TOKEN    "123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
#define TELEGRAM_CHAT_ID      "your_chat_id_number"

// ── Bot Kill Webhook (optional) ───────────────────────────────
// If your trading bot exposes a local HTTP endpoint for shutdown
// Leave empty string if using file flag method instead
#define BOT_KILL_WEBHOOK_URL  ""

#endif // SECRETS_H
